{
  "name": "resonance-bastion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests scripts *.ts",
    "format": "biome format --write src tests scripts *.ts *.json index.html",
    "format:check": "biome format src tests scripts *.ts *.json index.html",
    "test": "vitest run",
    "test:browser": "node scripts/build-run-journal-fixture.mjs && playwright test",
    "test:scenario": "node --experimental-strip-types scripts/headless.ts",
    "audit:art": "python3 scripts/audit-combat-art.py && node scripts/check-animation-rendering.mjs",
    "audit:balance": "vite build --ssr scripts/tutorial-balance.ts --outDir .cache/balance && node scripts/tutorial-balance.mjs",
    "traceability": "node scripts/index-blueprint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:scenario && npm run build",
    "audit:economy": "vite build --ssr scripts/economy-analysis.ts --outDir .cache/economy && node scripts/economy-analysis.mjs",
    "audit:movement": "vite build --ssr scripts/movement-audit.ts --outDir .cache/movement && node scripts/movement-audit.mjs",
    "audit:progression": "vite build --ssr scripts/progression-analysis.ts --outDir .cache/progression && node scripts/progression-analysis.mjs",
    "audit:progression-balance": "vite build --ssr scripts/progression-balance.ts --outDir .cache/progression-balance && node scripts/progression-balance.mjs",
    "audit:combat-progression": "vite build --ssr scripts/combat-progression-analysis.ts --outDir .cache/combat-progression && node scripts/combat-progression-analysis.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
